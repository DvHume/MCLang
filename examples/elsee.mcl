scoreboard set player_hp 100
scoreboard add player_hp -50

say "Check..."

#
# execute if score <variable> matches <value> run <statement>
#

execute if score player_hp matches 0 run say "Player dead" # Result: Player dead

# ELSE
# execute if score <variable> matches <value> run <statement> else run <statement>
#

execute if score player_hp matches 0 run say "Player dead" else run say "Player alive" #Result # Player alive